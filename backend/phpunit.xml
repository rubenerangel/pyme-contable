<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnRisky="true">
    <testsuites>
        <!-- Unit: pure domain, no Laravel and no database. -->
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <!-- Integration: invariants that live in Postgres (balancing, RLS, permissions, consecutive numbering). -->
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
        <!-- Feature: HTTP API. -->
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- Laravel reads $_SERVER before $_ENV and Docker injects DB_DATABASE=pyme: both are forced. -->
        <server name="APP_ENV" value="testing"/>
        <env name="APP_ENV" value="testing" force="true"/>
        <server name="DB_DATABASE" value="pyme_test"/>
        <env name="DB_DATABASE" value="pyme_test" force="true"/>
        <env name="APP_LOCALE" value="es" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <!-- The tests write no logs by themselves: those of logs redirect the stderr channel to a file. The quotes are
             needed: Laravel's env() turns a bare null into PHP null (no channel, so the emergency logger writes to
             storage/logs) and strips the quotes of a quoted value, leaving the name of the null channel. -->
        <env name="LOG_CHANNEL" value="'null'" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
    </php>
</phpunit>