# Solo desarrollo local. Copiar a .env. En producción los secretos vienen del gestor de secretos.
POSTGRES_PASSWORD=postgres-dev
PYME_OWNER_PASSWORD=owner-dev

# Puertos publicados en el host (solo 127.0.0.1).
PG_HOST_PORT=5433
APP_HOST_PORT=8080

# Usuario del host. Los contenedores escriben con estos IDs para no dejar archivos de root.
UID=1000
GID=1000