# Local development only. Copy to .env. In production, secrets come from the secrets manager.
POSTGRES_PASSWORD=postgres-dev
PYME_OWNER_PASSWORD=owner-dev
PYME_APP_PASSWORD=app-dev

# Ports published on the host (127.0.0.1 only).
PG_HOST_PORT=5433
APP_HOST_PORT=8080

# Host user. Containers write with these IDs so they do not leave root-owned files.
UID=1000
GID=1000