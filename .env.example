# Solo desarrollo local. Copiar a .env. En producción los secretos vienen del gestor de secretos.
POSTGRES_PASSWORD=postgres-dev
PYME_OWNER_PASSWORD=owner-dev
# Puerto publicado en el host. 5433 para no chocar con un Postgres local.
PG_HOST_PORT=
# Usuario del host. www-data del contenedor toma estos IDs para no dejar archivos de root en backend/.
UID=1000
GID=1000